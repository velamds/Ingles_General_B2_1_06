cted": 0, "_data": [{"type": "text", "content": "you are aiming to work for. The next section is"}]}, {"correct": 0, "text": "", "id": 3, "selected": 0, "_data": [{"type": "text", "content": "where"}]}, {"correct": 0, "text": "", "id": 4, "selected": 0, "_data": [{"type": "text", "content": "you provide details of the work experience"}]}, {"correct": true, "text": "", "id": 5, "selected": 0, "_data": [{"type": "text", "content": "that"}]}, {"correct": 0, "text": "", "id": 6, "selected": 0, "_data": [{"type": "text", "content": "you got at school, a job or a volunteer position. You can include the dates"}]}, {"correct": true, "text": "", "id": 7, "selected": 0, "_data": [{"type": "text", "content": "that"}]}, {"correct": 0, "text": "", "id": 8, "selected": 0, "_data": [{"type": "text", "content": "you worked. You can also include the experience"}]}, {"correct": false, "text": "", "id": 9, "selected": 0, "_data": [{"type": "text", "content": "that"}]}, {"correct": 0, "text": "", "id": 10, "selected": 0, "_data": [{"type": "text", "content": "is important. Include the year"}]}, {"correct": true, "text": "", "id": 11, "selected": 0, "_data": [{"type": "text", "content": "when"}]}, {"correct": 0, "text": "", "id": 12, "selected": 0, "_data": [{"type": "text", "content": "you received your degree or certificate and the year "}]}, {"correct": 0, "text": "", "id": 13, "selected": 0, "_data": [{"type": "text", "content": "that"}]}, {"correct": 0, "text": "", "id": 14, "selected": 0, "_data": [{"type": "text", "content": " is written on your degree. You can include any other information"}]}, {"correct": true, "text": "", "id": 15, "selected": 0, "_data": [{"type": "text", "content": "which "}]}, {"correct": 0, "text": "", "id": 16, "selected": 0, "_data": [{"type": "text", "content": "you think may be of interest to a potential employer."}]}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "text", "content": ""}]}, {"type": "objective", "content": "secondary_2"}]}], "template_override": 1, "id": 9, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " What does John think should be included in a r\u00e9sum\u00e9?"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Activity 2"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Select the relative pronouns (<span class=\"product-color-text\">that, who, which, when</span>) that are optional in the paragraph. \n<br>You have 2 attempts to submit your answers."}]}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}]}]}, {"stimuli_ids": [], "type": "RSLT", "questions": [{"responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 1}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "text", "content": ""}]}]}], "template_override": 1, "id": 10, "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!", "allowed_attempts": 2, "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}, {"stimuli_ids": [], "type": "DWS", "questions": [{"responses": [{"correct": 1, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "pdf", "content": "engenn9le06ob08re7pdf01.pdf"}]}]}], "template_override": 1, "id": 11, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": "\nMake a list of action verbs.\n"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!", "allowed_attempts": 2, "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n"}]}]}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn9le06ob08re2img05.jpg", "audiosrc": "engenn9le06ob08re2aud01", "images": [{"time": "0", "image": "engenn9le06ob08re2img05.jpg", "text": "", "id": 0}, {"time": "50", "image": "engenn9le06ob08re2img05.jpg", "text": "The first half of the workshop was great! We were shown what should be in a r\u00e9sum\u00e9 and what to do to set about writing a r\u00e9sum\u00e9. In the second half, we learned the steps to follow to write a r\u00e9sum\u00e9. After a style is decided on and you choose a job for your r\u00e9sum\u00e9, you should brainstorm your experience and skills.", "id": 1}, {"time": "22000", "image": "engenn9le06ob08re2img06.jpg", "text": "Then you're ready to write your r\u00e9sum\u00e9! Start with your contact information: your name, e-mail address and phone number at the top and usually centered on the page. Next you should put your statement of career objective, usually one line in sentence format. This is a very brief synopsis of who you are and the type of employer you are aiming to work for. If you don't have much work experience, you can list your qualifications in the next section. These are usually adjectives to describe your work ethic, like persistent, industrious or diligent.", "id": 2}, {"time": "58000", "image": "engenn9le06ob08re2img07.jpg", "text": "The next section is where you provide details of the work experience that you got at school, a job or a volunteer position. You want your r\u00e9sum\u00e9 to stand out from the rest so you need to get creative with your verbs. Use action verbs like reconciled, diagnosed and enhanced. If you have limited work experience you can list your employers and your position in the next section. You can include the dates you worked, but this is optional. The education that you received is listed in the next part. Include the year when you received your degree or certificate. If you want, you can include any other information which you think may be of interest to a potential employer. This can be interests, other skills or certificates.", "id": 3}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}, {"contents": [{"type": "video", "value": {"images": [{"time": "0", "image": "", "text": "", "id": 0}, {"time": "7000", "image": "", "text": "<span class=\"bullet\">What is a r\u00e9sum\u00e9?</span>", "id": 1}, {"time": "23000", "image": "", "text": "<span class=\"bullet\">What should you include in a r\u00e9sum\u00e9?</span>", "id": 2}], "video_src": "engenn9le6ob08re3vid01"}}], "template_override": 1, "title": "", "type": "video", "id": 2, "_data": []}, {"contents": [{"type": "p", "value": "<span class=\"strong\">Christine</span>: I need a r\u00e9sum\u00e9!\n<br/><span class=\"strong\">John</span>: Well, first you need to list your experiences and accomplishments. The next step is to choose a style of r\u00e9sum\u00e9.\n<br/><span class=\"strong\">Christine</span>: How do I know which style to choose?\n<br/><span class=\"strong\">John</span>: If you don't have much work experience, you should use the combination style. This style emphasizes qualifications and skills.\n<br/><span class=\"strong\">Christine</span>: Where should I put my education?\n<br/><span class=\"strong\">John</span>: You can put that toward the bottom of the page, or on the second page if your r\u00e9sum\u00e9 is two pages."}], "template_override": 1, "title": "", "type": "text", "id": 3, "_data": []}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "The Job Search"}, {"type": "unit_name", "content": "Keep It Short and to the Point! "}, {"type": "position", "content": 8}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 6}, {"type": "level", "content": "B2.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Identify and describe jobs and careers in both work and social contexts appropriate for the interlocutor."}, {"type": "secondary_1", "content": " Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}, {"type": "secondary_2", "content": " Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}, {"type": "secondary_3", "content": "Understands specific information in written texts about the different social and work contexts."}, {"type": "secondary_4", "content": "Understands specific information in written texts about the different social and work contexts."}, {"type": "secondary_5", "content": "Understands specific information in written texts about the different social and work contexts."}, {"type": "secondary_6", "content": "Understands specific information in written texts about the different social and work contexts."}, {"type": "secondary_7", "content": "Understands specific information in written texts about the different social and work contexts."}, {"type": "secondary_8", "content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Subject and object relative clauses: relative pronouns in object clauses"}, {"type": "describer", "content": "When you want to clarify which person or thing you are talking about, you use a relative clause. Relative clauses modify a noun. We use relative clauses to give additional information about something without starting a new sentence.<br>You put the relative clause immediately after the noun it describes."}, {"type": "text", "content": "An<span class=\"strong\"> object relative clause</span> describes the object of the clause and comes after the object of the sentence."}, {"type": "text", "content": "For example:<br><span class=\"italic\"> You can include the dates that you worked.</span><br>  Which <span class=\"italic\"> dates</span>? The<span class=\"italic\">  dates that you worked."}, {"type": "text", "content": "<span class=\"strong\">The relative pronoun is the object:"}, {"type": "text", "content": "When the relative pronoun is the object of the clause, you can drop the relative pronoun if you want to. "}, {"type": "text", "content": "For example:<br><br/>(Clause after the object)<br/><br/><ol><li>This is a very brief synopsis of the type of employer (who) you are aiming to work for.</li><li>The next section is where you provide details of the work experience (that) you got at school, a job or a volunteer position.</li><li>You can include the dates (that) you worked.</li><li>Include the year (when) you received your degree or certificate.</li><li>You can include any other information (which) you think may be of interest to a potential employer.</li></ol>"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " How to write a r\u00e9sum\u00e9 with action verbs"}, {"type": "describer", "content": " When you need to write a r\u00e9sum\u00e9 there are steps you can follow to make sure you include all the necessary information. Below are the steps to writing a great r\u00e9sum\u00e9. "}, {"type": "text", "content": "<span class=\"strong\">1. Choose a style (chronological, functional or combination)"}, {"type": "text", "content": "<span class=\"italic\">After a style is decided on and you choose a job for your r\u00e9sum\u00e9, you should brainstorm your experience and skills."}, {"type": "text", "content": "<span class=\"strong\">2. Contact information"}, {"type": "text", "content": "<span class=\"italic\">Start with your contact information: your name, e-mail address and phone number at the top and usually centered on the page. "}, {"type": "text", "content": "<span class=\"strong\">3. Objective statement"}, {"type": "text", "content": "<span class=\"italic\">Next you should put your statement of career objective, usually one line in sentence format. "}, {"type": "text", "content": "<span class=\"strong\">4. Qualifications"}, {"type": "text", "content": "<span class=\"italic\">If you don't have much work experience, you can list your qualifications in the next section. <br> Use action verbs like reconciled, diagnosed and enhanced. <br> These are usually adjectives to describe your work ethic, like persistent, industrious or diligent. "}, {"type": "text", "content": "<span class=\"strong\">5. Professional Experience"}, {"type": "text", "content": "<span class=\"italic\">The next section is where you provide details of the work experience that you got at school, a job or a volunteer position."}, {"type": "text", "content": "<span class=\"strong\">Work History"}, {"type": "text", "content": "<span class=\"italic\">If you have limited work experience you can list your employers and your position in the next section. You can include the dates that you worked, but this is optional."}, {"type": "text", "content": "<span class=\"strong\">Education"}, {"type": "text", "content": "<span class=\"italic\">The education that you received is listed in the next part. Include the year when you received your degree or certificate."}, {"type": "text", "content": "<span class=\"strong\">Achievements/Interests"}, {"type": "text", "content": "<span class=\"italic\">If you want, you can include any other information which you think may be of interest to a potential employer. This can be interests, other skills or certificates."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "synopsis "}, {"type": "definition", "content": " a \u200bshort \u200bdescription of something  "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: This is a very brief synopsis of who you are and the type of employer who you are aiming to work for. "}, {"type": "audio", "content": "engenn9le06ob08aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you use to write about events and experiences related to a job."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to aim for"}, {"type": "definition", "content": "to intend "}, {"type": "part_speech", "content": " (verb)"}, {"type": "example", "content": "Example: I aim to find a position in an advertising company."}, {"type": "audio", "content": "engenn9le06ob08aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to set about "}, {"type": "definition", "content": "to begin doing "}, {"type": "part_speech", "content": "(phrasal verb)"}, {"type": "example", "content": "Example: We were shown what should be in a r\u00e9sum\u00e9 and what to do to set about writing a r\u00e9sum\u00e9. "}, {"type": "audio", "content": "engenn9le06ob08aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "industrious "}, {"type": "definition", "content": " hard-working and productive "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: These are usually adjectives to describe your work ethic, like persistent, industrious and diligent."}, {"type": "audio", "content": "engenn9le06ob08aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "persistent "}, {"type": "definition", "content": "lasting for a long time "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: To find a job you have to be persistent in your search."}, {"type": "audio", "content": "engenn9le06ob08aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to reconcile "}, {"type": "definition", "content": "to \u200bfind a way in which two \u200bsituations or \u200bbeliefs that are \u200bopposed to each other can \u200bagree and \u200bexist together "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Use action verbs like reconciled, diagnosed and enhanced. "}, {"type": "audio", "content": "engenn9le06ob08aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to diagnose "}, {"type": "definition", "content": "to \u200brecognize and \u200bname the \u200bexact \u200bcharacter of a \u200bproblem, by \u200bexamining it "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Diagnose is a good action word to use on a r\u00e9sum\u00e9."}, {"type": "audio", "content": "engenn9le06ob08aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to enhance "}, {"type": "definition", "content": "to \u200bimprove the \u200bquality, \u200bamount, or \u200bstrength of something "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Her r\u00e9sum\u00e9 was enhanced by the addition of action verbs."}, {"type": "audio", "content": "engenn9le06ob08aud08"}]}, {"type": "background_image", "content": "engenn9le06ob08re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Think of a job you have or have had in the past. Or, think of work you have done at school."}, {"type": "text", "content": "Make a list of all the action verbs that you can use to describe the experience you have."}, {"type": "text", "content": "Use the internet if you need to find action verbs."}, {"type": "text", "content": "Compare your list with a partner's list."}, {"type": "text", "content": "Ask your partner to explain any verbs on their list that you do not know."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I think about my work experience."}, {"type": "text", "content": "I use action verbs to describe my experience."}, {"type": "text", "content": "I research action verbs on the internet."}, {"type": "text", "content": "I compare my list with a partner."}, {"type": "text", "content": "I ask my partner about new vocabulary."}]}]}