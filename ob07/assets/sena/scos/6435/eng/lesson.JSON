ontents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "type": "RSLT", "template_override": 1}, {"id": 11, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "engenn9le06ob07re7pdf01.pdf", "type": "pdf"}]}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": "Watch the movie: <span class=\"italic\">The Pursuit of Happiness</span>.\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}, {"content": "Listening", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "type": "DWS", "template_override": 1}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "The Job Search", "type": "lesson_name"}, {"content": "Musts in a R\u00e9sum\u00e9 ", "type": "unit_name"}, {"content": 7, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 6, "type": "lesson"}, {"content": "B2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Identify and describe jobs and careers in both work and social contexts appropriate for the interlocutor.", "type": "primary"}, {"content": "Understands specific information in written texts about the different social and work contexts.", "type": "secondary_1"}, {"content": "Understands specific information in written texts about the different social and work contexts.", "type": "secondary_2"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_3"}, {"content": "Understands specific information in written texts about the different social and work contexts.", "type": "secondary_4"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_5"}, {"content": "Understands specific information in written texts about the different social and work contexts.", "type": "secondary_6"}, {"content": "Understands specific information in written texts about the different social and work contexts.", "type": "secondary_7"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": "The Simple Present Passive with Infinitive Verbs", "type": "heading"}, {"content": "You use an active structure when you want the \u2018doer' of the action to be the subject.<br>You use a passive structure when you want the \u2018receiver' of the action to be the subject. ", "type": "describer"}, {"content": "In <span class=\"strong\"> active </span> sentences, the subject of the sentence does the action and the object of the sentence receives the action. The majority of sentences are active.", "type": "text"}, {"content": "[Thing doing action] + [verb] + [thing receiving action]", "type": "text"}, {"content": "For example: <br>Active sentence = <span class=\"italic\">Employers</span> (subject)<span class=\"italic\"> <span class=\"strong\">advertise</span> most jobs </span>(object) <span class=\"italic\">online</span>.", "type": "text"}, {"content": "In <span class=\"strong\"> passive </span> sentences, the object has been moved to the subject position. So, in a <span class=\"strong\"> passive </span> sentence the subject receives the action. The person or thing doing the action is either no longer in the sentence, or is included in a \u2018by' phrase.", "type": "text"}, {"content": "Sometimes you use the passive voice with an infinitive verb.", "type": "text"}, {"content": "The passive infinitive is made up of the marker to + be + a past participle.", "type": "text"}, {"content": "For example:<br> <span class=\"italic\"> The type of r\u00e9sum\u00e9 is <span class=\"strong\">to be considered</span>. </span> (Passive)<br>  <span class=\"italic\">People  <span class=\"strong\">are to consider</span> the type of r\u00e9sum\u00e9.  </span>(Active)", "type": "text"}, {"content": "The majority of verbs you will use have an active infinitive form (with or without to): (to) summarize, (to) attend, (to) learn, (to) report.", "type": "text"}, {"content": "The majority of verbs you will use can also have a passive infinitive form. This is made up of the infinitive of be (with or without to) + the past participle: (to) be summarized, (to) be given, (to) be learned, (to) be reported.", "type": "text"}, {"content": "This is a formal structure used mostly in writing.", "type": "text"}, {"content": "There is a lot of work to be done.", "type": "example"}, {"content": "Many different styles of r\u00e9sum\u00e9s are reported to be used.", "type": "example"}, {"content": "This section is expected to include details about your skills, qualifications and work experience.", "type": "example"}, {"content": "The last section covers your education, which is to be listed in reverse chronological order. ", "type": "example"}, {"content": "Next, the type of r\u00e9sum\u00e9 is to be considered.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": " Requirements of a r\u00e9sum\u00e9", "type": "heading"}, {"content": " There are many different types and styles of r\u00e9sum\u00e9s. Which type or style you choose may depend on the type of job you apply for. However, there are basic elements that must be included in every r\u00e9sum\u00e9.", "type": "describer"}, {"content": "A r\u00e9sum\u00e9 must contain four key sections:", "type": "text"}, {"content": "1) WHO YOU ARE:<br> <span class=\"strong\">The Heading</span> \u2013 Your name, and your contact information \u2013 e-mail address, phone numbers and postal address.", "type": "text"}, {"content": "2) WHAT YOU WANT:<br> <span class=\"strong\"> Job Objective </span>\u2013 One to three lines about the position you are interested in, what you are good at, what you want to do, and how it will benefit the employer. ", "type": "text"}, {"content": "3) WHAT YOU KNOW: <br> <span class=\"strong\"> Summary/Profile</span> (Optional): A short section with key statements that highlight your skills and experience. This has to work as an appetizer, tempting the reader to read the whole thing.", "type": "text"}, {"content": " <span class=\"strong\"> Skills and Qualifications</span> (Optional): A brief, to-the-point list (with sub-headers, if necessary) of your skills, areas of expertise, certifications and accomplishments that are relevant to the job on hand. ", "type": "text"}, {"content": " <span class=\"strong\"> Experience summary</span>: A listing of all the jobs you've held in your career, in reverse chronological order (the latest listed first). Within each job, mention clearly the name of the company, your designation, your role and your major contributions.  ", "type": "text"}, {"content": "4) WHAT YOU HAVE STUDIED:<br>  <span class=\"strong\"> Education</span>: List your education and training in reverse chronological order, along with where you have studied. ", "type": "text"}, {"content": "R\u00e9sum\u00e9s need to include four basic elements. ", "type": "example"}, {"content": "Information about who you are, your name and contact information, is recommended to be included in the first section.", "type": "example"}, {"content": "It's good to have this near the top of your r\u00e9sum\u00e9 so that potential employers can see right away if your needs correspond with theirs.", "type": "example"}, {"content": "Next, you need to include what you want, or your job objective.", "type": "example"}, {"content": "The next section should be about what you know. ", "type": "example"}, {"content": "The last section covers your education, listed in reverse chronological order. ", "type": "example"}, {"content": "There are three basic types of r\u00e9sum\u00e9s: chronological, functional and combination.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "to correspond ", "type": "name"}, {"content": "to \u200bmatch or be \u200bsimilar or \u200bequal ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Employers want to see right away if your needs correspond with theirs. ", "type": "example"}, {"content": "engenn9le06ob07aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use to talk about jobs, professions and careers.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "chronological ", "type": "name"}, {"content": "following the \u200border in which a \u200bseries of \u200bevents \u200bhappened ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: When a r\u00e9sum\u00e9 is in chronological order it focuses on your work experience.", "type": "example"}, {"content": "engenn9le06ob07aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "functional ", "type": "name"}, {"content": "designed to be \u200bpractical and \u200buseful \u200brather than \u200battractive ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: There are three basic types of r\u00e9sum\u00e9s: chronological, functional and combination. ", "type": "example"}, {"content": "engenn9le06ob07aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "combination", "type": "name"}, {"content": "the \u200bmixture you get when two or more things are \u200bcombined ", "type": "definition"}, {"content": " (noun)", "type": "part_speech"}, {"content": "Example: A combination r\u00e9sum\u00e9 is perfect if you are a first-time job seeker.", "type": "example"}, {"content": "engenn9le06ob07aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "copious ", "type": "name"}, {"content": "in \u200blarge \u200bamounts, or more than enough ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: The notes that I took are copious.", "type": "example"}, {"content": "engenn9le06ob07aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to summarize ", "type": "name"}, {"content": "to reduce a piece of writing to the main points", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example:  I'm summarizing them here so that you can benefit from what I learned.", "type": "example"}, {"content": "engenn9le06ob07aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "challenge", "type": "name"}, {"content": "a difficult task ", "type": "definition"}, {"content": " (noun)", "type": "part_speech"}, {"content": "Example: It is assumed to be easy to write a r\u00e9sum\u00e9, but it can be a challenge. ", "type": "example"}, {"content": "engenn9le06ob07aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to brainstorm", "type": "name"}, {"content": " to \u200bsuggest a lot of \u200bideas very \u200bquickly before \u200bconsidering some of them more \u200bcarefully ", "type": "definition"}, {"content": " (verb)", "type": "part_speech"}, {"content": "Example: You should brainstorm your experience and skills.", "type": "example"}, {"content": "engenn9le06ob07aud08", "type": "audio"}]}, {"content": "engenn9le06ob07re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Watch the movie: <span class=\"italic\">The Pursuit of Happiness</span>.", "type": "text"}, {"content": "While you are watching, take notes on what Chris Gardner does to try to get a job. ", "type": "text"}, {"content": "Write down any new vocabulary. Look it up in your dictionary.", "type": "text"}, {"content": "Write a paragraph summarizing his actions and comment on whether you agree or disagree with the things that he did.", "type": "text"}, {"content": "Present your summary and opinions to your class or group.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I watch a movie and take notes.", "type": "text"}, {"content": "I look up new vocabulary in the dictionary.", "type": "text"}, {"content": "I summarize the events in the movie.", "type": "text"}, {"content": "I express whether I agree or disagree with someone's actions.", "type": "text"}, {"content": "I present my summary and opinions to a group.", "type": "text"}]}], "type": "sena"}